{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_spec_citations.py\"",
            "timeout": 30,
            "statusMessage": "Checking engine rules cite the CDSi spec"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/analyze_edited.py\"",
            "timeout": 60,
            "statusMessage": "dart analyze on the edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/fast_tests_on_stop.py\"",
            "timeout": 180,
            "statusMessage": "Running cicada fast tests after Dart changes"
          }
        ]
      }
    ]
  }
}

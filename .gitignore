# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# Library packages (cicada itself) leave the lock out; the two application
# packages check theirs in, per dart.dev — an app's lock is the record of what
# it actually built against. Without it, cicada_generator and cicada_flutter
# silently sat on fhir_r4 0.7.0 for months while their pubspecs said ^0.8.0.
pubspec.lock
!cicada_generator/pubspec.lock
!cicada_flutter/pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# FHIR IG Publisher cache
input-cache/

# Trace output from cicada_generator/lib/trace_case.dart
scratch/

# IG publisher build output — regenerated by cicada_ig/_genonce.sh from
# input/, sushi-config.yaml, ig.ini and template/. 18,910 files of this were
# tracked, 98% of everything in the repo.
cicada_ig/temp/
cicada_ig/output/
# The publisher rewrites these on every run: a terminology cache keyed by a
# per-run uuid, and template scratch files. Neither is source.
cicada_ig/input-cache/txcache/
cicada_ig/template/[oO]n[LlGgCc]*
cicada_ig/template/versions.txt
